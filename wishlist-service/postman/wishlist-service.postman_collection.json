        {
          "name": "Wait for the headphones' inventory item (Kafka)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory/{{headphonesId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "inventory",
                "{{headphonesId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// inventory-service created the item",
                  "// Events travel through Kafka, so this can take a moment: retry this request until it's true.",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "const done = (() => { try { return pm.response.code === 200; } catch (e) { return false; } })();",
                  "if (!done && attempts < 20) {",
                  "    pm.collectionVariables.set('attempts', attempts + 1);",
                  "    setTimeout(() => {}, 1000);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('attempts', 0);",
                  "    pm.test('inventory-service created the item', () => pm.expect(done, 'still not true after 20 s - is Kafka running?').to.be.true);",
                  "}"
                ]
              }
            }
          ]
        },
