                  "// Events travel through Kafka, so this can take a moment: retry this request until it's true.",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "const done = (() => { try { return pm.response.json().data.content.some(n => n.eventType === 'WISHLIST_PRICE_DROPPED'); } catch (e) { return false; } })();",
                  "if (!done && attempts < 20) {",
                  "    pm.collectionVariables.set('attempts', attempts + 1);",
                  "    setTimeout(() => {}, 1000);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('attempts', 0);",
                  "    pm.test('notification-service sent the price-drop email', () => pm.expect(done, 'still not true after 20 s - is Kafka running?').to.be.true);",
                  "    const n = pm.response.json().data.content.find(n => n.eventType === 'WISHLIST_PRICE_DROPPED');",
                  "    pm.test('Subject names the new price', () => pm.expect(n.subject).to.include('is now INR 2,000.00'));",
                  "    pm.test('Sent to the customer', () => pm.expect(n.recipient).to.eql(pm.collectionVariables.get('customerEmail')));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mailpit: the price-drop email is in the inbox (http://localhost:8025)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailpitUrl}}/api/v1/search?query=to:{{customerEmail}}",
              "host": [
                "{{mailpitUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "to:{{customerEmail}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const subjects = pm.response.json().messages.map(m => m.Subject);",
                  "pm.test('Price drop email', () => pm.expect(subjects.some(s => s.startsWith('Price drop: Studio Headphones'))).to.be.true);",
                  "pm.test('Only one, however often the price is read', () => pm.expect(subjects.filter(s => s.startsWith('Price drop')).length).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
