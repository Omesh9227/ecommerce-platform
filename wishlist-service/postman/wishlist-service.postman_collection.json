{
  "info": {
    "name": "E-Commerce - Wishlist Service",
    "description": "Run with the Collection Runner (the 'Wait for ...' requests retry while Kafka events travel). Needs PostgreSQL, Kafka, Redis, Mailpit, discovery-server, config-server and all services. Saves products (one out of stock), puts the headphones on sale and waits for the price-drop email, then moves them to the cart.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
