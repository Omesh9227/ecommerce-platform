{
  "info": {
    "name": "E-Commerce - Notification Service",
    "description": "Run with the Collection Runner (the 'Wait for ...' requests retry while Kafka events travel). Needs PostgreSQL, Kafka, Redis, Mailpit (brew services start mailpit) and all services. Goes through a whole order - placed, declined payment, paid, shipped, out for delivery, a missed delivery, out for delivery again, delivered - and checks that exactly one email per step arrived, both via the notifications API and in Mailpit's inbox (open http://localhost:8025 to read them).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
