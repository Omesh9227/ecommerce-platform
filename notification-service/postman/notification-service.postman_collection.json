    {
      "name": "2. Emails",
      "item": [
        {
          "name": "Wait for 8 notifications (Kafka)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 8 emails were sent",
                  "// Events travel through Kafka, so this can take a moment: retry this request until it's true.",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "const done = (() => { try { return pm.response.json().data.totalElements >= 8; } catch (e) { return false; } })();",
                  "if (!done && attempts < 20) {",
                  "    pm.collectionVariables.set('attempts', attempts + 1);",
                  "    setTimeout(() => {}, 1000);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('attempts', 0);",
                  "    pm.test('8 emails were sent', () => pm.expect(done, 'still not true after 20 s - is Kafka running?').to.be.true);",
                  "    const types = pm.response.json().data.content.map(n => n.eventType);",
                  "    pm.test('One per step', () => pm.expect(types).to.have.members(['ORDER_PLACED','PAYMENT_FAILED','PAYMENT_SUCCEEDED','ORDER_SHIPPED','SHIPMENT_OUT_FOR_DELIVERY','SHIPMENT_DELIVERY_FAILED','SHIPMENT_OUT_FOR_DELIVERY','ORDER_DELIVERED']));",
                  "    pm.test('Sent to the customer', () => pm.response.json().data.content.forEach(n => pm.expect(n.recipient).to.eql(pm.collectionVariables.get('customerEmail'))));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mailpit: the emails are in the inbox (http://localhost:8025)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailpitUrl}}/api/v1/search?query=to:{{customerEmail}}",
              "host": [
                "{{mailpitUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "to:{{customerEmail}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const subjects = pm.response.json().messages.map(m => m.Subject);",
                  "const n = pm.collectionVariables.get('orderNumber');",
                  "pm.test('8 emails for this customer', () => pm.expect(subjects.length).to.eql(8));",
                  "pm.test('Order placed email', () => pm.expect(subjects).to.include(`Order ${n} placed - please complete your payment`));",
                  "pm.test('Shipped email', () => pm.expect(subjects).to.include(`Your order ${n} has shipped`));",
                  "pm.test('Out for delivery email', () => pm.expect(subjects).to.include(`Your order ${n} is out for delivery`));",
                  "pm.test('Missed delivery email', () => pm.expect(subjects).to.include(`We missed you - delivery of order ${n}`));"
                ]
              }
            }
          ]
        },
