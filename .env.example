# Template for .env (git-ignored). After cloning:  cp .env.example .env  and fill in real values.
# Format: KEY=VALUE, no quotes, no spaces around "=".

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# ---------- JWT (generate with: openssl rand -base64 48) ----------
JWT_SECRET=paste-a-base64-key-of-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600

# ---------- user-service ----------
USER_SERVICE_DB_NAME=ecommerce_user_db
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=Admin@12345

# ---------- product-service ----------
PRODUCT_SERVICE_DB_NAME=ecommerce_product_db

# ---------- inventory-service ----------
INVENTORY_SERVICE_DB_NAME=ecommerce_inventory_db

# ---------- order-service ----------
ORDER_SERVICE_DB_NAME=ecommerce_order_db

# ---------- payment-service ----------
PAYMENT_SERVICE_DB_NAME=ecommerce_payment_db

# ---------- notification-service (Mailpit locally: brew services start mailpit) ----------
NOTIFICATION_SERVICE_DB_NAME=ecommerce_notification_db
MAIL_HOST=localhost
MAIL_PORT=1025

# ---------- wishlist-service ----------
WISHLIST_SERVICE_DB_NAME=ecommerce_wishlist_db

# ---------- review-service ----------
REVIEW_SERVICE_DB_NAME=ecommerce_review_db

# ---------- shipping-service ----------
SHIPPING_SERVICE_DB_NAME=ecommerce_shipping_db

# ---------- search-service ----------
SEARCH_SERVICE_DB_NAME=ecommerce_search_db

# ---------- recommendation-service ----------
RECOMMENDATION_SERVICE_DB_NAME=ecommerce_recommendation_db

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- Redis (cart-service) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Eureka (discovery-server :8761) and Config Server (config-server :8888) ----------
# Letters and digits only (they become part of a URL). Generate with: openssl rand -hex 16
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=change-me-eureka-password
CONFIG_SERVER_USERNAME=config
CONFIG_SERVER_PASSWORD=change-me-config-password

# ---------- Where services find each other ----------
# Nothing to set: the gateway, cart-service and order-service look services up in Eureka (lb://order-service).
# Only to bypass Eureka for one service, e.g.:  ORDER_SERVICE_URL=http://localhost:8085

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000
