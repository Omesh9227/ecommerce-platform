                  "} else {",
                  "    pm.collectionVariables.set('attempts', 0);",
                  "    pm.test('inventory-service created the Case item', () => pm.expect(done, 'still not true after 20 s - is Kafka running?').to.be.true);",
                  "}"
                ]
              }
            }
          ]
