    {
      "name": "3. Kafka sync back to product-service",
      "item": [
        {
          "name": "Wait for product-service to show 18 in stock (INVENTORY_UPDATED via Kafka)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{phoneId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{phoneId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// product-service shows availableQuantity 18",
                  "// Events travel through Kafka, so this can take a moment: retry this request until it's true.",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "const done = (() => { try { return pm.response.json().data.availableQuantity === 18; } catch (e) { return false; } })();",
                  "if (!done && attempts < 20) {",
                  "    pm.collectionVariables.set('attempts', attempts + 1);",
                  "    setTimeout(() => {}, 1000);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('attempts', 0);",
                  "    pm.test('product-service shows availableQuantity 18', () => pm.expect(done, 'still not true after 20 s - is Kafka running?').to.be.true);",
                  "    pm.test('inStock is true', () => pm.expect(pm.response.json().data.inStock).to.be.true);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Products in stock (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
