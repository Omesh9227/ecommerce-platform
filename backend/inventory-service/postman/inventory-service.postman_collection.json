{
  "info": {
    "name": "E-Commerce - Inventory Service",
    "description": "Run top to bottom with the Collection Runner (right-click → Run collection): the 'Wait for ...' requests retry until the Kafka event has arrived, which only works in the Runner. Goes through the api-gateway on 8080, so start Kafka, user-service, product-service, inventory-service and api-gateway first. Every run uses a unique tag, so it can be re-run any time. adminEmail/adminPassword must match ADMIN_EMAIL/ADMIN_PASSWORD in .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup (logins, products)",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique tag per run, so SKUs and order references never clash with earlier runs",
                  "pm.collectionVariables.set('runTag', String(Date.now()).slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
