                  "pm.test('Phone is listed', () => pm.expect(items.map(p => p.id)).to.include(pm.collectionVariables.get('phoneId')));",
                  "pm.test('Everything listed is in stock', () => items.forEach(p => pm.expect(p.inStock).to.be.true));"
                ]
              }
            }
          ]
