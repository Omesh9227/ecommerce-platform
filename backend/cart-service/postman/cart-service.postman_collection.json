                "type": "text/javascript",
                "exec": [
                  "// cart shows INSUFFICIENT_STOCK",
                  "// Events travel through Kafka, so this can take a moment: retry this request until it's true.",
                  "const attempts = Number(pm.collectionVariables.get('attempts') || 0);",
                  "const done = (() => { try { return pm.response.json().data.items[0].status === 'INSUFFICIENT_STOCK'; } catch (e) { return false; } })();",
                  "if (!done && attempts < 20) {",
                  "    pm.collectionVariables.set('attempts', attempts + 1);",
                  "    setTimeout(() => {}, 1000);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set('attempts', 0);",
                  "    pm.test('cart shows INSUFFICIENT_STOCK', () => pm.expect(done, 'still not true after 20 s - is Kafka running?').to.be.true);",
